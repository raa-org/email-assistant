# ─────────────────────────────────────────────────────────────
# Email Assistant — environment template
#
#   cp .env.example .env
#
# Every value below is a placeholder. Nothing here is a real
# credential; generate your own before running anything.
# Keys are read in apps/backend/src/config/env.ts.
# ─────────────────────────────────────────────────────────────

# ── App / processes ──────────────────────────────────────────
# Public origin the browser uses. In production one reverse proxy
# serves the frontend and the backend from this single origin:
# /api/* to the backend, everything else to the frontend.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001

# ── Session ──────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=replace-me-with-32-random-bytes
AUTH_COOKIE_NAME=email_assistant_session
# Leave empty for host-only cookies; set for a shared parent domain.
AUTH_COOKIE_DOMAIN=

# ── Identity provider (OIDC) ─────────────────────────────────
# Any OIDC provider works; Keycloak is what this was built against.
OIDC_ISSUER=https://auth.example.com/realms/your-realm
OIDC_CLIENT_ID=email-assistant
OIDC_CLIENT_SECRET=replace-me
# Must match a redirect URI registered on the client. Takes
# precedence over APP_BASE_URL when building the callback.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Mail (IMAP) ──────────────────────────────────────────────
# Reached with XOAUTH2 using the signed-in user's access token,
# so no mailbox password is stored anywhere.
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_TLS=true
SENT_FOLDER=Sent

# ── Encryption at rest ───────────────────────────────────────
# Master secret for AES-256-GCM; per-user keys are derived from it
# with HKDF-SHA256. Rotating it invalidates every stored summary.
# openssl rand -hex 32
ENCRYPTION_MASTER_SECRET=replace-me-with-32-random-bytes

# ── LLM ──────────────────────────────────────────────────────
# Both providers can be configured side by side.
# LLM_DEFAULT_PROVIDER picks the one used when a request does not
# name one; per-request model/parameters override these defaults.
LLM_DEFAULT_PROVIDER=ollama
LLM_REQUEST_TIMEOUT_MS=60000
# 0 = unbounded. Caps parallel L1 calls during enrichment.
LLM_ENRICHMENT_CONCURRENCY=4

# Ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_API_KEY=
LLM_OLLAMA_DEFAULT_MODEL=llama3.1:8b
LLM_OLLAMA_DEFAULT_TEMPERATURE=
LLM_OLLAMA_DEFAULT_TOP_P=
LLM_OLLAMA_DEFAULT_MAX_TOKENS=
LLM_OLLAMA_DEFAULT_SEED=

# OpenAI-compatible gateway (vLLM, llama.cpp server, OpenWebUI, …)
LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_DEFAULT_MODEL=llama3.1:8b
LLM_OPENAI_COMPATIBLE_DEFAULT_TEMPERATURE=
LLM_OPENAI_COMPATIBLE_DEFAULT_TOP_P=
LLM_OPENAI_COMPATIBLE_DEFAULT_MAX_TOKENS=
LLM_OPENAI_COMPATIBLE_DEFAULT_SEED=
# Set true when the "OpenAI-compatible" endpoint is really Ollama
# behind a gateway and needs Ollama-shaped requests.
LLM_OPENAI_COMPATIBLE_OLLAMA_PASSTHROUGH=false

# ── Briefing / digest tuning ─────────────────────────────────
BRIEFING_MAX_PROMPT_CHARS=24000
BRIEFING_BATCH_SIZE=10
BRIEFING_MAX_MESSAGES=500
BRIEFING_CACHE_TTL_MINUTES=30
# Window for the statistics blocks (top contacts, sent/received).
# Digest content itself is always "all unread" and has no time bound.
DIGEST_STATS_WINDOW_DAYS=7

# ── Database ─────────────────────────────────────────────────
# DATABASE_URL is optional; without it the backend builds the DSN
# from the parts below.
# DATABASE_URL=postgres://dev:dev@localhost:5432/email_assistant
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_assistant
DB_USER=dev
DB_PASSWORD=dev
# Used only by `npm run db:create` to bootstrap the role and database.
DB_SUPERUSER=postgres
DB_SUPERPASS=postgres

# ── Cache ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
