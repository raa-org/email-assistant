{
  "name": "@raa/assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "nx": "nx",
    "serve:frontend": "nx serve frontend",
    "serve:backend": "nx serve backend",
    "start:frontend": "node scripts/run-frontend.js start",
    "start:backend": "node dist/apps/backend/apps/backend/src/main.js",
    "typeorm": "typeorm-ts-node-commonjs -d apps/backend/typeorm.config.ts",
    "db:create": "node scripts/create-db.js",
    "db:migration:generate": "node scripts/generate-migration.mjs",
    "db:migration:run": "npm run typeorm -- migration:run",
    "db:migration:revert": "npm run typeorm -- migration:revert",
    "db:migration:show": "npm run typeorm -- migration:show",
    "build:common": "nx build common",
    "build:backend": "nx build backend",
    "build:frontend": "nx build frontend",
    "build:all": "nx run-many -t build",
    "build": "npm run build:all && npm run db:migration:run",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@mui/material-nextjs": "9.0.0",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.18",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.2.7",
    "@nestjs/typeorm": "11.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "imapflow": "1.1.1",
    "jose": "^6.2.2",
    "next": "16.2.2",
    "openid-client": "^6.8.2",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-redux": "9.2.0",
    "redis": "5.11.0",
    "redux": "5.0.1",
    "redux-observable": "3.0.0-rc.3",
    "reflect-metadata": "0.2.2",
    "reselect": "5.1.1",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.17.3",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.27",
    "typesafe-actions": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.1",
    "nodemon": "3.1.10",
    "nx": "22.6.4",
    "prettier": "^3.8.1",
    "ts-node": "10.9.2",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  },
  "license": "MIT",
  "author": {
    "name": "Right&Above, LLC",
    "url": "https://rightandabove.com"
  },
  "description": "Self-hosted AI assistant for corporate email: per-message summaries, daily briefings and an actionable agenda, all inside your own network.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raa-org/email-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/raa-org/email-assistant/issues"
  },
  "homepage": "https://github.com/raa-org/email-assistant#readme"
}
